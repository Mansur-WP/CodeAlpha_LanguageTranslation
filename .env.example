# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change_this_to_a_random_secret_in_production
PORT=8080

# Translation Provider Configuration
# Supported providers: "deepl" (official API), "google", "mymemory"
TRANSLATION_PROVIDER=deepl

# DeepL API Authentication Key (Required when TRANSLATION_PROVIDER=deepl)
# Sign up at https://www.deepl.com/pro-api (Free or Pro tier)
# Free keys end in ':fx' (e.g. 12345678-abcd-1234-abcd-1234567890ab:fx)
DEEPL_AUTH_KEY=your_deepl_api_key_here

# Character limit for single translation request
MAX_CHAR_LIMIT=5000
