# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change_this_to_a_random_secret_in_production
PORT=8080

# Translation Provider Configuration
# Supported providers: "google" (default, free, no API key required), "mymemory"
TRANSLATION_PROVIDER=google

# Optional provider credentials (if configuring third-party accounts in future):
# MYMEMORY_EMAIL=user@example.com
